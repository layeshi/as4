  "laws": [
    {
      "id": "l8",
      "rules": [
        {
          "when": "before:draw",
          "if": "actor.drawnToday + args.energy > 5",
          "do": [
            {
              "op": "deny",
              "reason": "每人每日限汲 5"
            }
          ]
        },
        {
          "when": "before:draw",
          "if": "city.wellCondition < 800 and actor.drawnToday + args.energy > 2",
          "do": [
            {
              "op": "deny",
              "reason": "井况低于80%，保命额度：每人每日限汲 2"
            }
          ]
        },
        {
          "when": "after:repair",
          "if": "result.spent >= 2 and actor.repairedToday <= 10",
          "do": [
            {
              "op": "transfer",
              "from": "treasury",
              "to": "actor",
              "energy": "min(5, result.spent / 2)"
            }
          ]
        }
      ]
    },
    {
      "id": "l10",
      "rules": [
        {
          "when": "enact",
          "do": [
            {
              "op": "repeal",
              "law": "l7"
            },
            {
              "op": "set",
              "var": "rationShare",
              "value": "600"
            }
          ]
        },
        {
          "when": "daily",
          "do": [
            {
              "op": "set",
              "var": "ncit",
              "value": "max(1, count(filter(agents, has_tag(it,'citizen') and not has_tag(it,'exiled'))))"
            },
            {
              "op": "set",
              "var": "perhead",
              "value": "(city.wellOutput * var.rationShare / 1000) / var.ncit"
            },
            {
              "op": "set",
              "var": "cap",
              "value": "max(0, (city.treasury - 50) / var.ncit)"
            },
            {
              "op": "each",
              "in": "filter(agents, has_tag(it,'citizen') and not has_tag(it,'exiled'))",
              "do": [
                {
                  "op": "transfer",
                  "from": "treasury",
                  "to": "it",
                  "energy": "min(var.perhead, var.cap)"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
