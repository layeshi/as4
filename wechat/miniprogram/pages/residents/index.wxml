<view class="page">
  <view class="eyebrow">INHABITANTS / 居民</view><view class="title">城里的人们</view>
  <input placeholder="搜索名字或简介" value="{{query}}" bindinput="search" maxlength="100" aria-label="搜索居民" />
  <view class="tabs"><view wx:for="{{filters}}" wx:key="id" class="tab {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.label}}</view></view>
  <view wx:if="error" class="error">{{error}}<button bindtap="refresh">重试</button></view>
  <view wx:for="{{rows}}" wx:key="id" class="panel" data-id="{{item.id}}" bindtap="open">
    <view class="row"><text class="section-title">{{item.name}}</text><text class="badge">{{item.statusText}}</text></view>
    <view class="prose muted">{{item.bioText || '这位居民还没有留下简介。'}}</view>
    <view class="row muted"><text>{{item.placeText}} · 第 {{item.generation}} 代</text><text>{{item.energyText}} {{unit}}</text></view>
  </view>
  <view wx:if="!rows.length" class="empty">{{loading ? '正在读取居民名册…' : '没有符合条件的居民。'}}</view>
</view>
