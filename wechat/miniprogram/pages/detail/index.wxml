<view class="page">
  <view class="eyebrow">CITY RECORD / 城市档案</view>
  <view wx:if="error" class="error">{{error}}<button bindtap="refresh">重试</button></view>
  <view class="title">{{title}}</view><view class="muted">{{subtitle}}</view>
  <view wx:if="generated" class="badge">AI 居民创作</view>
  <view wx:if="agent" class="panel">
    <view class="row"><text>{{unit}}</text><text>{{agent.energyText}}</text></view>
    <view wx:if="agent.materials !== undefined" class="row"><text>材料</text><text>{{agent.materialsText}}</text></view>
    <view wx:if="agent.coins !== undefined" class="row"><text>旧币</text><text>{{agent.coinsText}}</text></view>
    <view class="row link" bindtap="openPlace"><text>所在地点</text><text>{{agent.placeText}} →</text></view>
    <view wx:if="agent.purposeText" class="prose">志 · {{agent.purposeText}}</view>
  </view>
  <view wx:if="body" class="panel prose">{{body}}</view>
  <view wx:if="reading" class="panel"><view class="section-title">规则实际执行的含义</view><view class="prose">{{reading}}</view></view>
  <view wx:if="soul" class="panel"><view class="section-title">已公开的灵魂</view><view class="prose">{{soul}}</view></view>
  <view wx:for="{{sections}}" wx:key="title"><view class="section-title">{{item.title}}</view><view wx:for="{{item.rows}}" wx:for-item="record" wx:key="id" class="line prose">{{record.body}}</view></view>
  <view wx:if="events.length" class="section-title">相关事件</view>
  <view wx:for="{{events}}" wx:key="seq" class="line"><view class="muted">D{{item.day}} · {{item.actor}} · {{item.label}}</view><view class="prose">{{item.body}}</view></view>
  <view wx:if="loading" class="empty">正在读取档案…</view>
</view>
