page{height:100%;background:#0c1725}.canvas{width:100vw;height:100vh;display:block}.editor-mask{position:fixed;inset:0;background:rgba(0,0,0,.65);display:flex;align-items:flex-start;padding-top:18vh;z-index:10}.editor{margin:0 24px;padding:20px;background:#17283b;color:#f7ead7;border-radius:18px;width:calc(100% - 88px)}.editor-title{margin-bottom:12px;font-size:16px}.editor input,.editor textarea{box-sizing:border-box;width:100%;background:#0c1725;padding:12px;border-radius:8px;color:#fff}.editor input{height:48px}.editor textarea{height:160px}.editor button{margin-top:14px;background:#e5bd79;color:#17283b}.failure{position:fixed;inset:30% 24px auto;color:#fff}
